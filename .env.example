# ─── Required ───
DATABASE_URL=                 # postgresql://user:password@host:5432/tab_pms?schema=public
SESSION_SECRET=               # 64 random hex chars: openssl rand -hex 32
APP_URL=                      # public URL, e.g. https://pms.tabconsultants.ae (used in email links and SSO redirect)
SESSION_TIMEOUT_HOURS=        # default 8
COOKIE_SECURE=                # set to false ONLY when running over plain http on a local network (laptop / office LAN)

# ─── Mail transport ───
# Leave unset in production (Graph is used when GRAPH_* is set). "console" logs instead of sending (development/tests).
MAIL_TRANSPORT=

# ─── Connector: Microsoft Graph (app-only) — reminders, digests, Outlook timeline ───
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SYNC_MAILBOXES=         # comma-separated shared mailboxes to read for the client timeline (Phase 2)

# ─── Connector: Microsoft Entra ID single sign-on (delegated, OIDC) ───
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ─── Connector: website / Zapier / Power Automate lead webhook ───
LEAD_WEBHOOK_SECRET=          # shared secret sent as the x-webhook-secret header

# ─── Seed (first run) ───
SEED_DEMO=                    # "false" in production: configuration only, no demo clients
SEED_ADMIN_EMAIL=             # break-glass administrator
SEED_ADMIN_PASSWORD=          # 12+ characters; change at first sign-in
SEED_DEMO_PASSWORD=           # password for demo users when SEED_DEMO is not "false"
